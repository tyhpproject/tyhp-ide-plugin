<?tyhpdef

namespace Sample;

use App\Models\User;
use function App\Helpers\{formatCurrency};

const string APP_NAME;
resource|false $stream;

function fopen(string $filename, string $mode): resource|false;

class Money {
    public function plus(Money $other): Money;
    public function __toString(): string;

    extension fn formatCurrency(string $locale = 'en_US'): string => $locale . ' ' . $this->__toString();

    extension fn shortLabel(): string => $this->formatCurrency();

    extension operator +(self $left, self $right): self => $left->plus($right);

    use extension MoneyFormatting {
        formatCurrency as format;
    }
}

extension StringExtensions extends string {
    fn toCamelCase(): string => \lcfirst($this);
}

extension NumericHelpers {
    extends int {
        fn abs(): int => \abs($this);
    }
}

use extension MoneyFormatting {
    MoneyFormatting::operator +<Money> hide;
}
